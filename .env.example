# Chaves públicas e de servidor do Supabase (Lovable Cloud).
# Não coloque a service role em variável com prefixo VITE_.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Asaas. A chave fica só no servidor (EasyPanel), nunca no navegador.
# ASAAS_API_URL é opcional. Sem ela, chave de produção usa api.asaas.com e chave de homologação usa o sandbox.
ASAAS_API_KEY=
ASAAS_API_URL=

# Evolution API 2.4.0. Estas chaves ficam só no servidor (EasyPanel), nunca no navegador.
# Sem EVO_API_URL, o servidor usa o endereço interno já usado pelos alertas de saldo.
EVO_API_URL=
EVO_API_KEY=
APP_URL=
# Base que a Evolution usa para POSTar webhooks no NEX.
# Na VPS (mesmo host da Evolution), use o gateway Docker para evitar ECONNREFUSED em :443:
# EVO_WEBHOOK_BASE_URL=http://172.17.0.1:30320
# Sem esta variável, cai em APP_URL ou https://app.nexmeta.com.br (hairpin pode falhar).
EVO_WEBHOOK_BASE_URL=

# OpenAI — Lab. Calibração IA / NEX Intelligence (só EasyPanel/servidor).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# ChatGPT Actions / Custom GPT / MCP Career (só EasyPanel/servidor).
# REST + MCP direto: Authorization: Bearer <CHATGPT_INTEGRATION_SECRET>
# REST: /api/integrations/chatgpt/career/*
# MCP:  /api/integrations/chatgpt/career/mcp
# ChatGPT Web OAuth 2.1 (authorization_code + PKCE S256) — NÃO reutiliza o Bearer acima:
#   AS: /.well-known/oauth-authorization-server
#   PRM: /.well-known/oauth-protected-resource
#   authorize/token/register: /api/integrations/chatgpt/career/oauth/*
CHATGPT_INTEGRATION_SECRET=
# Opcional: rotação sem downtime.
CHATGPT_INTEGRATION_SECRET_PREVIOUS=
# Assinatura JWT do OAuth Career (obrigatório para ChatGPT Web). Segredo distinto do Bearer.
CAREER_MCP_OAUTH_SIGNING_SECRET=
# Opcional: redirect_uris extras (vírgula) além dos padrões chatgpt.com / chat.openai.com.
CAREER_MCP_OAUTH_REDIRECT_URIS=
# Opcional: lista de organization_id permitidos (vírgula). Vazio = todas.
CHATGPT_INTEGRATION_ORG_ALLOWLIST=

# Cron de alerta de saldo Meta (WhatsApp). Sem depender do cliente abrir a NEX.
# POST/GET https://app.nexmeta.com.br/api/meta/low-balance-scan
# Authorization: Bearer <META_LOW_BALANCE_CRON_SECRET>
# Se vazio, aceita CHATGPT_INTEGRATION_SECRET.
META_LOW_BALANCE_CRON_SECRET=

# Candidatura (Career) — painel Master exclusivo.
# Por padrão o backend libera só walkup@walkuptec.com.br (profiles.email → id).
# Opcional: force o UUID interno sem depender do e-mail.
CAREER_ALLOWED_USER_ID=
# Opcional: sobrescreve o e-mail canônico (default walkup@walkuptec.com.br).
CAREER_ALLOWED_EMAIL=
