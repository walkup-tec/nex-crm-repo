# Chaves públicas e de servidor do Supabase (Lovable Cloud).
# Não coloque a service role em variável com prefixo VITE_.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Asaas. A chave fica só no servidor (EasyPanel), nunca no navegador.
# ASAAS_API_URL é opcional. Sem ela, chave de produção usa api.asaas.com e chave de homologação usa o sandbox.
ASAAS_API_KEY=
ASAAS_API_URL=

# Evolution API 2.4.0. Estas chaves ficam só no servidor (EasyPanel), nunca no navegador.
# Sem EVO_API_URL, o servidor usa o endereço interno já usado pelos alertas de saldo.
EVO_API_URL=
EVO_API_KEY=
APP_URL=

# OpenAI — Lab. Calibração IA / NEX Intelligence (só EasyPanel/servidor).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# ChatGPT Actions / Custom GPT — consulta de execuções Meta IA (só EasyPanel/servidor).
# Authorization: Bearer <CHATGPT_INTEGRATION_SECRET>
CHATGPT_INTEGRATION_SECRET=
# Opcional: rotação sem downtime.
CHATGPT_INTEGRATION_SECRET_PREVIOUS=
# Opcional: lista de organization_id permitidos (vírgula). Vazio = todas.
CHATGPT_INTEGRATION_ORG_ALLOWLIST=
